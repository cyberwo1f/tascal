{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    /* esbuild が CJS（.cjs）へバンドルするため、型チェックも CommonJS 前提に揃える
       （__dirname 等のランタイム前提を一致させる） */
    "module": "CommonJS",
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "noEmit": true,

    /* 厳格な型チェック（ルートと同水準） */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["."]
}
