{
  "name": "tascal",
  "private": true,
  "version": "1.0.0",
  "description": "Tascal — シンプルで気持ちのいい ToDo アプリ",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "vite",
